    "graph:analyze": "ts-node src/commands/analyze-graph.ts",
    "graph:required": "ts-node src/commands/required-components.ts",
    "graph:required-by-name": "ts-node src/commands/required-components-by-name.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git@github.enterprise.io:bertrand-delion/repo-tools.git"
  },
