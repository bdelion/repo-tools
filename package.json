    "@types/node": "^22.13.14",
    "@types/semver": "^7.7.0",
    "commander": "^13.1.0",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.29.0"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
